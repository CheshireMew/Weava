{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@weava/core": ["./packages/core/src/index.ts"],
      "@weava/contracts": ["./packages/contracts/src/index.ts"],
      "@weava/contracts/api": ["./packages/contracts/src/admin-api.ts"],
      "@weava/contracts/api-client": ["./packages/contracts/src/api-client.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/admin/src/**/*.ts",
    "apps/admin/src/**/*.tsx",
    "apps/web/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
