---
import SiteLocale from '../components/SiteLocale.astro';
import {systemRoutes, textFor} from '@weava/contracts';
import {selectPublicPage} from '../../../../packages/core/src/public-page-selection.ts';
import {publicDocumentResponse} from '../public-documents.ts';
import {customPageResponse} from '../custom-page.ts';
import { site, siteExtension, engagement, features } from '../runtime.ts';
import {
  responsiveImages,
  imageAttributes,
  escape as e,
  renderNavigation,
  queryPublished,
  contentQuery,
  pageLinks,
  renderEntryTemplate,
  renderSharedRegion,
  originalWordPressImages,
  feedLinks,
} from '@weava/core';
import '../styles/site.css';
import SearchResults from '../components/SearchResults.astro';
import Newsletter from '../themes/Newsletter.astro';
import Library from '../themes/Library.astro';
import NotesTimeline from '../components/NotesTimeline.astro';
import {notesTimeline,notesPath,paginate} from '@weava/core';
import ArticleComments from '../themes/ArticleComments.astro';
import SeoHead from '../components/SeoHead.astro';
import Advertisement from '../components/Advertisement.astro';
import SiteInfoLinks from '../components/SiteInfoLinks.astro';
import { WeavaError, supportsDiscussion } from '@weava/contracts';
const owner=site.authenticate(Astro.cookies.get('weava-session')?.value??'');
let page:ReturnType<typeof selectPublicPage>;
try {page=selectPublicPage(site,Astro.url,owner,Astro.locals.weavaRelease);}
catch(error) {if(!(error instanceof WeavaError))throw error;return new Response(error.message,{status:error.status,headers:{'Content-Type':'text/plain; charset=utf-8'}});}
const {preview,release,entry}=page;
Astro.locals.weavaRelease=release;
const privateArticle = entry?.visibility === 'private';
if (preview || privateArticle) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
const sitemapMetadata = new Map();
if (Astro.url.pathname === systemRoutes.sitemap || Astro.url.pathname === systemRoutes.videoSitemap) {
  const manager = await siteExtension;
  const entries = release.entries.filter(item => item.indexable && item.visibility !== 'private' &&
    (Astro.url.pathname === systemRoutes.sitemap || item.html?.includes('<video')));
  for (let offset = 0; offset < entries.length; offset += 4) await Promise.all(entries.slice(offset, offset + 4).map(async item => {
    sitemapMetadata.set(item.id, await manager.metadata(item, release, new URL(item.path, release.settings.domain), { html: item.html }));
  }));
}
const documentResponse=publicDocumentResponse(release,Astro.url,sitemapMetadata);
if(documentResponse)return documentResponse;
const customResponse=await customPageResponse(Astro.request,Astro.url,release,entry,preview);
if(customResponse)return customResponse;
const settings = release.settings,
  theme = settings.themeConfig;
const t=textFor(settings.language);
const isNotesIndex=entry?.kind==='page'&&entry.path===notesPath(release);
const notesPage=paginate(isNotesIndex?notesTimeline(release):[],isNotesIndex?Number(Astro.url.searchParams.get('page')??1):1,20);
const notesLinks=pageLinks(notesPage,Astro.url);
const missing = !entry && Astro.url.pathname !== '/search/';
if (missing) Astro.response.status = 404;
const canonical = settings.domain.replace(/\/$/, '') + (entry?.path ?? Astro.url.pathname);
const title = entry?.title ?? (missing ? t('页面未找到') : t('搜索'));
const description = entry?.description ?? settings.description;
const content = responsiveImages(site, originalWordPressImages(
  entry ? renderEntryTemplate(entry, release, (await siteExtension)?.blocks, { url: Astro.url, editable: preview && Astro.url.searchParams.get('editor') === '1', editTemplate: preview && !!Astro.url.searchParams.get('layout') && release.layouts?.find((layout) => layout.id === Astro.url.searchParams.get('layout'))?.kind === 'template' }) : '', entry));
const headerRegion = responsiveImages(site, renderSharedRegion('header', release, entry, (await siteExtension)?.blocks));
const footerRegion = responsiveImages(site, renderSharedRegion('footer', release, entry, (await siteExtension)?.blocks));
const beforeRegion = responsiveImages(site, renderSharedRegion('before', release, entry, (await siteExtension)?.blocks));
const afterRegion = responsiveImages(site, renderSharedRegion('after', release, entry, (await siteExtension)?.blocks));
const resultsPage = Astro.url.pathname === '/search/'
  ? queryPublished(site, { ...contentQuery(Astro.url.searchParams), pageSize: 20 }, true, release.id)
  : { items: [], page: 1, pageSize: 20, total: 0, pages: 0 };
const results = resultsPage.items;
const searchLinks = pageLinks(resultsPage, Astro.url);
const metadata = await (await siteExtension).metadata(entry, release, Astro.url, { preview, missing, media: true, html: content + headerRegion + beforeRegion + afterRegion + footerRegion });
const schema = metadata.schema;
const interactive=features.includes('engagement')&&supportsDiscussion(entry)&&!preview&&!privateArticle;
const readerCookie=Astro.cookies.get('weava-reader')?.value;
const discussion=interactive?engagement.summary(entry!.id,/^[a-f0-9]{64}$/.test(readerCookie??'')?readerCookie:undefined):null;
---

<!doctype html>
{settings.theme === 'library' ? <Library release={release} entry={entry} metadata={metadata} preview={preview} missing={missing} results={results} searchPagination={{...searchLinks,page:resultsPage.page,pages:resultsPage.pages,total:resultsPage.total}}/> : <>
{settings.theme === 'newsletter' ? <Newsletter release={release} entry={entry} title={title} description={description} canonical={metadata.canonical} schema={schema} metadata={metadata} content={content} beforeRegion={beforeRegion} afterRegion={afterRegion} headerRegion={headerRegion} footerRegion={footerRegion} results={results} searchPagination={{ ...searchLinks, page: resultsPage.page, pages: resultsPage.pages, total: resultsPage.total }} preview={preview} missing={missing} owner={owner} /> : <>
<html lang={settings.language}>
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><SiteLocale language={settings.language}/><SeoHead metadata={metadata} />{feedLinks(entry, release).slice(1).map((link) => <link rel="alternate" type="application/rss+xml" title={link.title} href={link.url} />)}<link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
    /></head
  >
  <body
    style={`--accent:${theme.accent};--paper:${theme.background};--width:${theme.width}px;--radius:${theme.radius}px;--space:${theme.spacing}px;font-family:${theme.font}`}
    data-release={release.id}
    data-article-id={interactive?entry?.id:undefined} data-canonical={canonical} data-language={settings.language} data-timezone={settings.timezone}
    data-track={!preview && !privateArticle && !missing ? 'true' : 'false'}
  >
    <a class="skip" href="#main">{t("跳到正文")}</a>
    {headerRegion ? <header class="wrap" set:html={headerRegion} /> : <header class="site-header wrap">
      <a class="brand" href="/"
        >{
          settings.logo ? (
            <img {...imageAttributes(site, settings.logo, {width:30,height:30})} alt="" decoding="async" />
          ) : (
            <span class="brand-icon">w</span>
          )
        }{settings.name}</a
      ><button class="menu-button" aria-expanded="false" aria-controls="nav">{t("菜单")}</button><nav
        id="nav" aria-label={t("主导航")}
      >
        <Fragment set:html={renderNavigation(settings.navigation, entry?.path, release)} /><a href="/search/" aria-label={t("搜索")}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg></a>
      </nav>
    </header>}
    <div class="wrap weava-advertisement-region"><Advertisement settings={settings} position="siteTop" /></div>
    {beforeRegion && <div class="wrap shared-region" set:html={beforeRegion} />}
    <main id="main" tabindex="-1" class:list={['wrap', entry?.kind === 'content' ? 'reading' : '']}>
      {entry?.kind === 'content' && <Advertisement settings={settings} position="articleTop" />}
      {
        isNotesIndex?<section><h1>{entry!.title}</h1><NotesTimeline release={release} items={notesPage.items} page={notesPage.page} pages={notesPage.pages} previous={notesLinks.previous} next={notesLinks.next}/></section>:entry && (
          <div class="page-body" data-article-body={entry.kind==='content'?true:undefined}>{entry.template==='guestbook'&&<h1>{entry.title}</h1>}<Fragment set:html={content}/></div>
        )
      }
      {entry?.kind === 'content' && <Advertisement settings={settings} position="articleBottom" />}
      {discussion&&<div class="site-discussion"><ArticleComments guestbook={entry?.template==='guestbook'} items={discussion.items} hasMore={discussion.hasMore} language={settings.language} timezone={settings.timezone} allowComments={entry?.allowComments}/></div>}
      {
        missing && (
          <section class="hero">
            <>
              <h1>{t("页面未找到")}</h1>
              <p>{t("这个地址还没有公开内容。")}</p>
              <a href="/" class="button">{t('返回首页')}</a>
            </>
          </section>
        )
      }
      {
        Astro.url.pathname === '/search/' && (
          <section class="search-page">
            <>
              <h1>{t("搜索")}</h1>
              <form method="get">
                <>
                  <input
                    type="search"
                    name="q"
                    placeholder={t("搜索文章、作品或资源")}
                    aria-label={t("搜索文章、作品或资源")}
                    value={Astro.url.searchParams.get('q') ?? ''}
                  />
                  <button class="button">{t("搜索")}</button>
                </>
              </form>
              <SearchResults results={results} pagination={{...searchLinks,page:resultsPage.page,pages:resultsPage.pages,total:resultsPage.total}} language={settings.language}/>
            </>
          </section>
        )
      }
    </main>{afterRegion && <div class="wrap shared-region" set:html={afterRegion} />}
    <div class="wrap weava-advertisement-region"><Advertisement settings={settings} position="siteBottom" /></div>
    <SiteInfoLinks release={release} />
    {footerRegion ? <footer class="wrap" set:html={footerRegion} /> : <footer class="wrap site-footer">
      <span>{settings.footer}</span>{(settings.sourceUrl || release.entries.some((e) => e.path === '/about/' && !e.source?.siteInfoRole)) &&
        <a href={settings.sourceUrl || '/about/'}>{settings.sourceUrl ? t('源代码') : t('关于')}</a>}
      <a href="/rss.xml">RSS</a>
    </footer>}
    {!preview && <script src="/weava-ui.js" defer is:inline />}
    {interactive&&<script src="/weava-article.js" defer is:inline />}
    {!preview && entry?.kind === 'content' && <script src="/weava-article-copy.js" defer is:inline />}
    {features.includes('analytics') && !preview && !privateArticle && !missing && <script src="/weava-analytics.js" defer is:inline />}
  {(!preview || Astro.url.searchParams.get('embedded') !== '1') && <script src="/weava-code.js" defer is:inline />}
  </body>
</html>
</>}
</>}
