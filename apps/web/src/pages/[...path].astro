---
import { site, siteExtension } from '../runtime.ts';
import {
  normalizePath,
  renderBlocks,
  renderDocument,
  renderFields,
  responsiveImages,
  imageAttributes,
  escape as e,
  renderNavigation,
  resolveContentLinks,
  queryPublished,
  contentQuery,
  pageLinks,
  renderEntryTemplate,
  renderSharedRegion,
  layouts,
  pageMetadata,
  composeMetadata,
} from '@weava/core';
import '../styles/site.css';
import Newsletter from '../themes/Newsletter.astro';
import SeoHead from '../components/SeoHead.astro';
import { entrySchema } from '@weava/contracts';
const preview = Astro.url.pathname.startsWith('/__preview/');
const token = Astro.cookies.get('weava-session')?.value ?? '';
const owner = site.authenticate(token);
if (preview && !owner) return new Response('请先登录后台。', { status: 401 });
const publicDocument = ['/sitemap.xml', '/rss.xml', '/robots.txt', '/search/'].includes(Astro.url.pathname);
let release =
  site.visibleRelease(owner && !publicDocument) ??
  (preview
    ? {
        id: 'preview',
        createdAt: new Date().toISOString(),
        label: '草稿预览',
        entries: [],
        types: site.store.list('type').map((r) => r.value),
        settings: site.settings().value,
      }
    : null);
if (!release) return new Response('网站尚未发布，请登录后台发布内容。', { status: 503 });
let entry;
if (preview) {
  const id = decodeURIComponent(Astro.url.pathname.slice(11).replace(/\/$/, ''));
  const version = Number(Astro.url.searchParams.get('revision'));
  const stored = version
    ? site.store.raw
        .prepare('SELECT data FROM revisions WHERE scope=? AND id=? AND revision=?')
        .get('entry', id, version)
    : null;
  let value = version
    ? stored
      ? JSON.parse((stored as any).data)
      : null
    : site.store.get('entry', id)?.value;
  if (id.startsWith('layout:')) {
    const layout = layouts(site).find((row) => row.id === id.slice(7))?.value;
    if (!layout) return new Response('布局不存在。', { status: 404 });
    value = entrySchema.parse({ id, kind: layout.appliesTo === 'content' ? 'content' : 'page', title: '示例标题', description: '示例摘要', path: '/layout-preview/',
      type: site.store.list('type')[0]?.id ?? 'post', template: layout.kind === 'template' ? layout.id : 'page', document: { version: 1, format: 'markdown', source: '## 示例正文\n\n这里显示内容正文。' },
      blocks: layout.kind === 'template' ? [] : layout.blocks });
  }
  entry = value ? { ...value, html: renderDocument(value.document) } : null;
  if (!entry) return new Response('草稿修订不存在。', { status: 404 });
  release = {
    ...release,
    settings: site.settings().value,
    types: site.store.list('type').map((r) => r.value),
    layouts: layouts(site).map((row) => row.value),
  };
  const selectedLayout = Astro.url.searchParams.get('layout');
  if (selectedLayout) {
    const layout = release.layouts.find((layout) => layout.id === selectedLayout);
    if (!layout) return new Response('布局不存在。', { status: 404 });
    entry = layout.kind === 'template' ? { ...entry, template: layout.id } : { ...entry, kind: 'page', template: 'page', blocks: layout.blocks, title: layout.label };
  }
  release = { ...release, entries: [...release.entries.filter((item) => item.id !== entry.id), entry] };
} else entry = release.entries.find((v) => v.path === normalizePath(Astro.url.pathname));
const privateArticle = entry?.visibility === 'private';
if (preview || privateArticle) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
if (Astro.url.pathname === '/sitemap.xml')
  return new Response(
    '<?xml version="1.0" encoding="utf-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">' +
      release.entries
        .filter((v) => v.indexable)
        .map(
          (v) =>
            `<url><loc>${e(release.settings.domain.replace(/\/$/, '') + v.path)}</loc><lastmod>${v.modifiedAt?.slice(0, 10) ?? release.createdAt.slice(0, 10)}</lastmod></url>`,
        )
        .join('') +
      '</urlset>',
    { headers: { 'Content-Type': 'application/xml' } },
  );
if (Astro.url.pathname === '/robots.txt')
  return new Response(
    `User-agent: *\nDisallow: /admin/\nDisallow: /__preview/\nSitemap: ${release.settings.domain.replace(/\/$/, '')}/sitemap.xml\n`,
    { headers: { 'Content-Type': 'text/plain' } },
  );
if (Astro.url.pathname === '/rss.xml')
  return new Response(
    '<?xml version="1.0"?><rss version="2.0"><channel><title>' +
      e(release.settings.name) +
      '</title><link>' +
      e(release.settings.domain) +
      '</link><description>' +
      e(release.settings.description) +
      '</description>' +
      release.entries
        .filter((v) => v.kind === 'content' && v.indexable)
        .sort((a, b) => String(b.publishedAt).localeCompare(String(a.publishedAt)))
        .slice(0, 30)
        .map((v) => {
          const date = v.publishedAt
            ? '<pubDate>' + new Date(v.publishedAt).toUTCString() + '</pubDate>'
            : '';
          return `<item><title>${e(v.title)}</title><link>${e(release.settings.domain + v.path)}</link><guid isPermaLink="false">${e(v.id)}</guid><description>${e(v.description)}</description>${date}</item>`;
        })
        .join('') +
      '</channel></rss>',
    { headers: { 'Content-Type': 'application/xml' } },
  );
if (entry) {
  const custom = await (await siteExtension)?.render?.(entry, release);
  if (custom) {
    const metadata = await (await siteExtension).metadata(entry, release, Astro.url, { preview, html: custom });
    const html = composeMetadata(custom, metadata, { preview, track: !preview && !privateArticle, releaseId: release.id });
    return new Response(html, {
      headers: {
        'Content-Type': 'text/html; charset=utf-8',
        ...(preview
          ? {
              'Content-Security-Policy': "script-src 'none'; connect-src 'none'; object-src 'none'",
            }
          : {}),
        ...(preview || privateArticle ? { 'Cache-Control': 'private, no-store', 'X-Robots-Tag': 'noindex, nofollow' } : {}),
      },
    });
  }
}
const settings = release.settings,
  theme = settings.themeConfig;
const missing = !entry && Astro.url.pathname !== '/search/';
if (missing) Astro.response.status = 404;
const canonical = settings.domain.replace(/\/$/, '') + (entry?.path ?? Astro.url.pathname);
const title = entry?.title ?? (missing ? '页面未找到' : '搜索');
const description = entry?.description ?? settings.description;
const content = responsiveImages(
  site,
  entry ? renderEntryTemplate(entry, release, (await siteExtension)?.blocks, { url: Astro.url, editable: preview && Astro.url.searchParams.get('editor') === '1', editTemplate: preview && !!Astro.url.searchParams.get('layout') && release.layouts?.find((layout) => layout.id === Astro.url.searchParams.get('layout'))?.kind === 'template' }) : '',
);
const headerRegion = responsiveImages(site, renderSharedRegion('header', release, entry, (await siteExtension)?.blocks));
const footerRegion = responsiveImages(site, renderSharedRegion('footer', release, entry, (await siteExtension)?.blocks));
const beforeRegion = responsiveImages(site, renderSharedRegion('before', release, entry, (await siteExtension)?.blocks));
const afterRegion = responsiveImages(site, renderSharedRegion('after', release, entry, (await siteExtension)?.blocks));
const resultsPage = Astro.url.pathname === '/search/'
  ? queryPublished(site, { ...contentQuery(Astro.url.searchParams), pageSize: 20 }, true, release.id)
  : { items: [], page: 1, pageSize: 20, total: 0, pages: 0 };
const results = resultsPage.items;
const searchLinks = pageLinks(resultsPage, Astro.url);
const metadata = await (await siteExtension).metadata(entry, release, Astro.url, { preview, missing, html: content + headerRegion + beforeRegion + afterRegion + footerRegion });
const schema = metadata.schema;
---

<!doctype html>
{settings.theme === 'newsletter' ? <Newsletter release={release} entry={entry} title={title} description={description} canonical={metadata.canonical} schema={schema} metadata={metadata} content={content} beforeRegion={beforeRegion} afterRegion={afterRegion} headerRegion={headerRegion} footerRegion={footerRegion} results={results} searchPagination={{ ...searchLinks, page: resultsPage.page, pages: resultsPage.pages }} preview={preview} missing={missing} owner={owner} /> : <>
<html lang={settings.language}>
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><SeoHead metadata={metadata} /><link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
    /></head
  >
  <body
    style={`--accent:${theme.accent};--paper:${theme.background};--width:${theme.width}px;--radius:${theme.radius}px;--space:${theme.spacing}px;font-family:${theme.font}`}
    data-release={release.id}
    data-track={!preview && !privateArticle && !missing ? 'true' : 'false'}
  >
    <a class="skip" href="#main">跳到正文</a>{headerRegion ? <header class="wrap" set:html={headerRegion} /> : <header class="site-header wrap">
      <a class="brand" href="/"
        >{
          settings.logo ? (
            <img src={settings.logo} alt="" width="30" height="30" />
          ) : (
            <span class="brand-icon">w</span>
          )
        }{settings.name}</a
      ><button class="menu-button" aria-expanded="false" aria-controls="nav">菜单</button><nav
        id="nav" aria-label="主导航"
      >
        <Fragment set:html={renderNavigation(settings.navigation, entry?.path, release)} /><a href="/search/" aria-label="搜索"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg></a>
      </nav>
    </header>}
    {beforeRegion && <div class="wrap shared-region" set:html={beforeRegion} />}
    <main id="main" tabindex="-1" class:list={['wrap', entry?.kind === 'content' ? 'reading' : '']}>
      {
        entry && (
          <div class="page-body" set:html={content} />
        )
      }
      {
        missing && (
          <section class="hero">
            <>
              <h1>页面未找到</h1>
              <p>这个地址还没有公开内容。</p>
              <a href="/" class="button">
                返回首页
              </a>
            </>
          </section>
        )
      }
      {
        Astro.url.pathname === '/search/' && (
          <section class="search-page">
            <>
              <h1>搜索</h1>
              <form method="get">
                <>
                  <input
                    type="search"
                    name="q"
                    placeholder="搜索文章、作品或资源"
                    aria-label="搜索文章、作品或资源"
                    value={Astro.url.searchParams.get('q') ?? ''}
                  />
                  <button class="button">搜索</button>
                </>
              </form>
              <div class="search-results">
                {results.map((r: any) => (
                  <a href={r.path}>
                    <h2>{r.title}</h2>
                    <p>{r.description}</p>
                  </a>
                ))}
              </div>
              {Astro.url.searchParams.get('q') && !results.length && <p role="status">没有找到匹配的内容，请换个关键词。</p>}
              {resultsPage.pages > 1 && <nav class="pagination" aria-label="搜索分页">{searchLinks.previous && <a rel="prev" href={searchLinks.previous}>上一页</a>}<span>{resultsPage.page} / {resultsPage.pages}</span>{searchLinks.next && <a rel="next" href={searchLinks.next}>下一页</a>}</nav>}
            </>
          </section>
        )
      }
    </main>{afterRegion && <div class="wrap shared-region" set:html={afterRegion} />}{footerRegion ? <footer class="wrap" set:html={footerRegion} /> : <footer class="wrap site-footer">
      <span>{settings.footer}</span>{(settings.sourceUrl || release.entries.some((e) => e.path === '/about/')) &&
        <a href={settings.sourceUrl || '/about/'}>{settings.sourceUrl ? '源代码' : '关于'}</a>}
      <a href="/rss.xml">RSS</a>
    </footer>}
    {!preview && <script src="/weava-ui.js" defer is:inline />}
    {!preview && !privateArticle && !missing && <script src="/weava-analytics.js" defer is:inline />}
  </body>
</html>
</>}
