---
import type {PublishedEntry,Release} from '@weava/contracts';
import {renderNoteDocument,resolveContentLinks,imageAttributes,responsiveImages} from '@weava/core';
import {site} from '../runtime.ts';
interface Props{entry:PublishedEntry;release:Release;editUrl?:string;}
const {entry,release,editUrl}=Astro.props,settings=release.settings;
const date=new Intl.DateTimeFormat(settings.language,{dateStyle:'medium',timeStyle:'short',timeZone:settings.timezone}).format(new Date(entry.publishedAt??entry.createdAt??release.createdAt));
const html=responsiveImages(site,resolveContentLinks(renderNoteDocument(entry.document),release));
---
<article class="note-detail" data-note-body>
 <header><span class="note-detail-avatar">{settings.logo&&<img {...imageAttributes(site,settings.logo,{width:36,height:36})} alt="" decoding="async"/>}</span><div><strong>{entry.author||settings.name}</strong><time datetime={entry.publishedAt}>{date}</time></div>{editUrl&&<a href={editUrl}>编辑</a>}</header>
 <div class="prose" set:html={html}/>
</article>
<style>
 .note-detail{max-width:680px;margin:24px auto 48px}.note-detail>header{display:flex;align-items:center;gap:12px;margin-bottom:20px}.note-detail>header>div{display:grid;gap:3px}.note-detail time{font-size:12px;color:#777}.note-detail>header>a{margin-left:auto;font-size:13px}.note-detail-avatar{width:36px;height:36px;border-radius:50%;overflow:hidden;background:#f4f4f4}.note-detail-avatar img{width:100%;height:100%;object-fit:cover}.note-detail :global(.prose){font-size:16px;line-height:1.7}.note-detail :global(img),.note-detail :global(video){max-width:100%;height:auto}.note-detail :global(pre){overflow:auto}
</style>
