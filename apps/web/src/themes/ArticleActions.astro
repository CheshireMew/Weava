---
interface Props { position: string; counts: { likes: number; comments: number }; }
const { position, counts } = Astro.props;
---
<div class="nl-article-actions" data-article-actions>
  <div class="nl-action-left">
    <button type="button" class="nl-round-action" data-article-action="like" aria-label="点赞" aria-pressed="false" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 5.5a5.2 5.2 0 0 0-7.4 0L12 6.6l-1.1-1.1a5.2 5.2 0 0 0-7.4 7.4L12 21l8.5-8.1a5.2 5.2 0 0 0 0-7.4Z" /></svg>
      <span data-like-count hidden={counts.likes === 0}>{counts.likes}</span>
    </button>
    <a class="nl-round-action" href="#comments" aria-label="查看评论">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-9.5 9 10 10 0 0 1-4.2-1L3 21l1.5-4.3a10 10 0 0 1-1-4.2 9 9 0 1 1 17.5-1Z" /></svg>
      <span data-comment-count hidden={counts.comments === 0}>{counts.comments}</span>
    </a>
    <button type="button" class="nl-round-action" data-article-action="copy" aria-label="复制文章链接">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m10 13 4-4M8 16l-2 2a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m4 0 2-2a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0" transform="translate(1 -1)" /></svg>
    </button>
  </div>
  <div class="nl-action-right">
    <button type="button" class="nl-share-action" data-article-action="share">分享</button>
    <div class="nl-more-wrap">
      <button type="button" class="nl-round-action" data-article-action="more" aria-label="更多文章操作" aria-expanded="false" aria-controls={`article-menu-${position}`}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" /></svg></button>
      <div class="nl-more-menu" id={`article-menu-${position}`} hidden>
        <button type="button" data-article-action="copy">复制链接</button><button type="button" data-article-action="print">打印文章</button>
      </div>
    </div>
  </div>
</div>
