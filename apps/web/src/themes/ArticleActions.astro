---
import {textFor} from '@weava/contracts';
interface Props { language?:string; position: string; counts: { likes: number; comments: number }; }
const { counts } = Astro.props;
const t=textFor(Astro.props.language??'zh-CN');
---
<div class="nl-article-actions" data-article-actions>
  <div class="nl-action-left">
    <button type="button" class="nl-round-action" data-article-action="like" aria-label={t("点赞")} aria-pressed="false" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 5.5a5.2 5.2 0 0 0-7.4 0L12 6.6l-1.1-1.1a5.2 5.2 0 0 0-7.4 7.4L12 21l8.5-8.1a5.2 5.2 0 0 0 0-7.4Z" /></svg>
      <span data-like-count hidden={counts.likes === 0}>{counts.likes}</span>
    </button>
    <a class="nl-round-action" href="#comments" aria-label={t("查看评论")}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-9.5 9 10 10 0 0 1-4.2-1L3 21l1.5-4.3a10 10 0 0 1-1-4.2 9 9 0 1 1 17.5-1Z" /></svg>
      <span data-comment-count hidden={counts.comments === 0}>{counts.comments}</span>
    </a>
  </div>
  <div class="nl-action-right">
    <button type="button" class="nl-share-action" data-article-action="share">{t("分享")}</button>
  </div>
</div>
